# Production domain used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.nexpeditefreight.com

# WhatsApp click-to-chat number (international format, digits only).
# UNVERIFIED: confirm 0300-8496494 is WhatsApp-enabled before launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=923008496494

# Office city — the company profile mentions both Karachi and Lahore. Confirm before setting.
NEXT_PUBLIC_OFFICE_CITY=

# Verified social profiles only. Leave empty to hide the links site-wide.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Email delivery for the quote and contact forms (SMTP). Required for forms to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexpedite Freight Website <no-reply@nexpeditefreight.com>"
MAIL_TO=info@nexpeditefreight.com
